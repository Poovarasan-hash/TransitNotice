# TransitNotice Server Environment Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=transitnotice_jwt_super_secret_dev_key_2026

# Scheduler Configuration
REFRESH_INTERVAL_MS=120000
FETCH_TIMEOUT_MS=8000
MAX_RETRIES=3

# Demo Alert Dispatcher
DEMO_ALERTS_ENABLED=true

# Official Government & Agency API Credentials (Optional)
# If provided, the adapters use live authenticated endpoints; otherwise, verified snapshot & open public portal feeds are utilized.
DELHI_OTD_API_KEY=
DATA_GOV_IN_API_KEY=
BMTC_ITS_API_KEY=
