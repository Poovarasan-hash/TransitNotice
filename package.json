{
  "name": "transitnotice",
  "version": "2.0.0",
  "description": "TransitNotice — Public Transport Service Update Tracker for India (FastAPI + PostgreSQL/SQLAlchemy + React)",
  "main": "backend/app/main.py",
  "scripts": {
    "dev": "concurrently -k -n \"api,client\" -c \"cyan,magenta\" \".\\.venv\\Scripts\\python.exe -m uvicorn backend.app.main:app --host 0.0.0.0 --port 8000 --reload\" \"npm --prefix client run dev\"",
    "backend": ".\\.venv\\Scripts\\python.exe -m uvicorn backend.app.main:app --host 0.0.0.0 --port 8000 --reload",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": ".\\.venv\\Scripts\\python.exe -m uvicorn backend.app.main:app --host 0.0.0.0 --port 8000",
    "test": ".\\.venv\\Scripts\\python.exe -m pytest backend/tests",
    "test:node": "node --test server/tests/*.test.js",
    "migrate": "cd backend && ..\\.venv\\Scripts\\alembic.exe upgrade head"
  },
  "keywords": [
    "transit",
    "transport",
    "advisories",
    "fastapi",
    "postgresql",
    "sqlalchemy",
    "react",
    "gtfs",
    "service-alerts"
  ],
  "author": "TransitNotice Team",
  "license": "MIT",
  "dependencies": {
    "concurrently": "^10.0.6"
  }
}
